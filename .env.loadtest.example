# TESTING environment only. Never copy production values here; never reuse the production bot token,
# database, volume or domain. Use:  docker compose -p dating-bot-loadtest --env-file .env.loadtest ...
# (or prefix the command with ENV_FILE=.env.loadtest if this file has no ENV_FILE line)

# Makes the containers read THIS file (`--env-file` alone only feeds Compose's own ${...} values).
ENV_FILE=.env.loadtest

# --- explicit test environment (all required; anything else makes the load tester refuse) ---
APP_ENV=testing
LOAD_TEST_ENABLED=1
# Any id you choose (8-64 letters, digits, - _). The SAME id goes into the database comment:
#   COMMENT ON DATABASE <POSTGRES_DB> IS 'load-test-environment:<LOAD_TEST_ENV_ID>';
LOAD_TEST_ENV_ID=env-testing-change-me
# Must equal POSTGRES_DB and contain "test".
LOAD_TEST_DB_NAME=dating_loadtest
POSTGRES_DB=dating_loadtest
POSTGRES_USER=dating_loadtest
POSTGRES_PASSWORD=
# Numeric id of the TEST bot (the part of BOT_TOKEN before the colon). Create a separate bot in BotFather.
BOT_TOKEN=
LOAD_TEST_BOT_ID=
# Your Telegram id; the confirmation message is sent here.
ADMIN_IDS=
# The testing admin panel's host name, listed explicitly.
ADMIN_DOMAIN=loadtest-admin.example.com
LOAD_TEST_ALLOWED_DOMAINS=loadtest-admin.example.com
ADMIN_BOT_USERNAME=
ADMIN_SESSION_SECRET=

# --- extra protection: values that must NEVER be matched (optional but recommended) ---
# LOAD_TEST_PRODUCTION_BOT_IDS=123456789
# LOAD_TEST_PRODUCTION_DOMAINS=admin-bot.nxt-server.cloud
# LOAD_TEST_PRODUCTION_DB_NAMES=dating_bot

# --- operator limits (the admin UI can only choose lower values) ---
# LOAD_TEST_MAX_CHATS=2000
# LOAD_TEST_MAX_MSGS_PER_CHAT_MIN=120
# LOAD_TEST_MAX_TOTAL_MSGS_PER_MIN=100000
# LOAD_TEST_MAX_DURATION_S=1800
# LOAD_TEST_MAX_RAMP_S=900
# LOAD_TEST_MAX_TOTAL_MESSAGES=3000000
# LOAD_TEST_POOL_SIZE=10
# Optional: monitor the web service (internal http URL only; sent with Host: ADMIN_DOMAIN).
# LOAD_TEST_WEB_HEALTH_URL=http://web:8000/healthz
# Optional: stored in reports.
# LOAD_TEST_DOCKER_VERSION=
# APP_COMMIT=

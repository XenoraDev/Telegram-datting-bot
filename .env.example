# Copy to .env and fill in. .env is gitignored, never commit it.

# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=
# Comma separated Telegram user ids allowed to use admin features (used from P3)
ADMIN_IDS=

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=dating_bot
# Any characters are fine (the bot percent-encodes it). Example:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=dating_bot

# --- Web admin (P5; docker compose --profile web ...) ---
# Public host name of the panel. DNS A record -> this server; HTTPS is done by aaPanel/Apache (see README).
ADMIN_DOMAIN=admin-bot.nxt-server.cloud
# The bot's @username (BotFather). Also run  /setdomain  in BotFather with ADMIN_DOMAIN
# so the Telegram Login Widget works on the login page.
ADMIN_BOT_USERNAME=
# Random secret for CSRF tokens, at least 32 chars:  openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Loopback port the host's Apache proxies to (127.0.0.1 only, never public). Change if 8000 is taken.
# ADMIN_WEB_PORT=8000

# --- App ---
LOG_LEVEL=INFO
# How long a random-chat search waits for a partner before it is cancelled (1-240, default 30).
# QUEUE_TIMEOUT_MINUTES=30

# --- Backups (scripts/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Only for running the bot OUTSIDE docker compose. Either set a full URL (percent-encode special
# characters in the password) or POSTGRES_HOST/POSTGRES_PORT next to the POSTGRES_* above:
# DATABASE_URL=postgresql://dating_bot:PASSWORD@127.0.0.1:5432/dating_bot
# POSTGRES_HOST=127.0.0.1

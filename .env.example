# Copy to .env and fill in. .env is gitignored, never commit it.

# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=
# Comma separated Telegram user ids allowed to use admin features (used from P3)
ADMIN_IDS=

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=dating_bot
# Use a URL-safe password (no @ : / ? # %), e.g.:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=dating_bot

# --- App ---
LOG_LEVEL=INFO

# --- Backups (scripts/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Only for running the bot OUTSIDE docker compose (compose builds this itself and
# overrides any value set here):
# DATABASE_URL=postgresql://dating_bot:PASSWORD@127.0.0.1:5432/dating_bot
